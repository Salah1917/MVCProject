@model PL.ViewModels.UserViewModels.UserViewModel
@{
    ViewData["Title"] = "User Details";
}

<h2>User Details</h2>

<table class="table">
    <tr><th>ID</th><td>@Model.Id</td></tr>
    <tr><th>First Name</th><td>@Model.FirstName</td></tr>
    <tr><th>Last Name</th><td>@Model.LastName</td></tr>
    <tr><th>User Name</th><td>@Model.UserName</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr>
        <th>Roles</th>
        <td>
            @foreach (var role in Model.Roles)
            {
                <span class="badge bg-primary">@role</span>
            }
        </td>
    </tr>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Manage Roles</a>
